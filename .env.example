# Copy this file to .env.local and replace the placeholders with your local values.
# Local PostgreSQL connection and development credentials.
# Requires PostgreSQL >= 15.

# Local PostgreSQL database
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/mini_commerce"

# Auth.js secret
AUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET"

# Local seed accounts
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="REPLACE_WITH_A_LOCAL_ADMIN_PASSWORD"

USER_NAME="User"
USER_EMAIL="user@example.com"
USER_PASSWORD="REPLACE_WITH_A_LOCAL_USER_PASSWORD"

# Docker Compose PostgreSQL initialization
POSTGRES_PASSWORD="REPLACE_WITH_YOUR_POSTGRES_PASSWORD"
